[Unit]
Description=Agent Room human control plane
Documentation=https://github.com/msitarzewski/agent-room
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
ConditionPathIsExecutable=/opt/agentroom/current/bin/agentroomd
ConditionPathIsReadWrite=/var/lib/agentroom

[Service]
Type=notify
NotifyAccess=main
User=agentroom
Group=agentroom
WorkingDirectory=/var/lib/agentroom
ExecStart=/opt/agentroom/current/bin/agentroomd --config /etc/agentroom/agentroom.conf
Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=45s
WatchdogSec=30s
KillSignal=SIGTERM
UMask=0077

LoadCredentialEncrypted=database-url:/etc/agentroom/credentials/database-url.cred
LoadCredentialEncrypted=session-secret:/etc/agentroom/credentials/session-secret.cred
LoadCredentialEncrypted=oidc-client-secret:/etc/agentroom/credentials/oidc-client-secret.cred
LoadCredential=tls-cert:/etc/agentroom/credentials/tls-cert.pem
LoadCredentialEncrypted=tls-key:/etc/agentroom/credentials/tls-key.cred
LoadCredential=tls-client-ca:/etc/agentroom/credentials/tls-client-ca.pem
Environment=AGENTROOM_DATABASE_URL_FILE=%d/database-url
Environment=AGENTROOM_SESSION_SECRET_FILE=%d/session-secret
Environment=AGENTROOM_OIDC_CLIENT_SECRET_FILE=%d/oidc-client-secret
Environment=AGENTROOM_TLS_CERT_FILE=%d/tls-cert
Environment=AGENTROOM_TLS_KEY_FILE=%d/tls-key
Environment=AGENTROOM_TLS_CLIENT_CA_FILE=%d/tls-client-ca

StateDirectory=agentroom
StateDirectoryMode=0700
RuntimeDirectory=agentroom
RuntimeDirectoryMode=0700
LogsDirectory=agentroom
LogsDirectoryMode=0700
ReadWritePaths=/var/lib/agentroom /var/log/agentroom
ReadOnlyPaths=/etc/agentroom/agentroom.conf /opt/agentroom/current/web

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @swap
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

LimitNOFILE=65536
LimitNPROC=4096
TasksMax=4096
MemoryMax=2G

[Install]
WantedBy=multi-user.target
