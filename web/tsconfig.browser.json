{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["tests/browser/**/*.ts"]
}
